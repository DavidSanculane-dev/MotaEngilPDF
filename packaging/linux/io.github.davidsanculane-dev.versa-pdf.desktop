[Desktop Entry]
Type=Application
Name=Mota-Engil PDF Editor
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfcraft %U
TryExec=pdfcraft
Icon=io.github.davidsanculane-dev.versa-pdf
Terminal=false
StartupNotify=true
StartupWMClass=io.github.davidsanculane-dev.versa-pdf
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
